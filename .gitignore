# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
wheels/

# ---- Tooling caches ----
.ruff_cache/
.mypy_cache/
.pytest_cache/

# ---- Coverage / quality-tool output ----
.coverage
.coverage.*
coverage.xml
htmlcov/
bandit-report.json

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Build output (Nuitka compile dir + staged distributable) ----
build/

# ---- Local app data / databases (never commit live or staging data) ----
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
# the shipped catalog is the one exception — keep it tracked
!src/labdesk/seed.sqlite

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*~

# ---- OS cruft ----
.DS_Store
Thumbs.db
*.kate-swp
.*.swp
.*.swo

# Licensing: NEVER commit the private signing key or issued licenses
licensing-keys/
*.lic
license.lic
*.key

# Build-time generated (schema+seed baked in) — never commit
src/labdesk/_embedded_data.py

# Mutation testing sandbox + cache
/mutants/
.mutmut-cache
mutants.lock
